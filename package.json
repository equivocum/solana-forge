{
  "name": "solana-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Learn Solana blockchain internals through an interactive manufacturing game",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/frontend",
    "build": "npm run build --workspace=packages/frontend",
    "test": "vitest run",
    "test:gate1": "vitest run tests/gate/gate1.test.ts",
    "test:gate2": "vitest run tests/gate/gate2.test.ts",
    "test:gate3": "vitest run tests/gate/gate3.test.ts",
    "test:gate4": "vitest run tests/gate/gate4.test.ts",
    "test:gate5": "vitest run tests/gate/gate5.test.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@noble/ed25519": "^3.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
