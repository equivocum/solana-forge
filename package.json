{
  "name": "solana-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive Solana validator architecture visualization",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
